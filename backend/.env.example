# Copia este archivo como .env y llena los valores.
PORT=3000
ORIGEN_PERMITIDO=http://localhost:5500

# Proveedor de IA: simulado | gemini
# "simulado" no hace ninguna llamada de red: devuelve un analisis falso pero
# con la forma exacta del esquema. Sirve para desarrollar sin gastar cuota.
IA_PROVEEDOR=simulado

# Solo si IA_PROVEEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash

# Ruta del archivo de base de datos
DB_RUTA=./datos/estudio.db
